
 &param0
 nx           =     3200, ! 2.84x domain size from default 440
 ny           =     2500, ! 2.2x fomain size from default 440
 nz           =     300,
 ppnode       =      192, ! changed to 192 as that's the cores per node on Trillium [PSB], vary for timing tests
 timeformat   =       2,
 timestats    =       1,
 terrain_flag = .false.,
 procfiles    = .false.,
 /

 &param1
 dx     =  150.0,
 dy     =  150.0,
 dz     =  100.0,
 dtl    =   2.000,
 timax  =  28800.0, !8 hours
 run_time =  3600.0, !run for an hour, before restarting [PSB]
 tapfrq =   300.0, ! save output every 5 minutes [PSB]
 rstfrq = 1200.0, ! save restart file after every 20 minutes to be safe while conserving space [PSB]
 statfrq =   5.0, !was 60 [PSB]
 prclfrq =   60.0, !was 60 [PSB]
 /

 &param2
 cm1setup  =  1,
 testcase  =  0,
 adapt_dt  =  1, ! changed from default of 0
 irst      =  1, 
 rstnum    =  3,
 iconly    =  0,
 hadvordrs =  5,
 vadvordrs =  5,
 hadvordrv =  5,
 vadvordrv =  5,
 advwenos  =  2,
 advwenov  =  0,
 weno_order = 5,
 apmasscon =  0, !SWITCHED [PSB]
 idiff     =  0,
 mdiff     =  0,
 difforder =  6,
 imoist    =  1,
 ipbl      =  0,
 sgsmodel  =  1,
 tconfig   =  1,
 bcturbs   =  1,
 horizturb =  0,
 doimpl    =  1,
 irdamp    =  1,
 hrdamp    =  1, !turn on to block gravity waves
 psolver   =  2,
 ptype     =  5,
 ihail     =  1,
 iautoc    =  1,
 icor      =  0,
 lspgrad   =  0,
 eqtset    =  2,
 idiss     =  1,
 efall     =  0,
 rterm     =  0,
 wbc       =  1, !make these periodic so no lines [PSB]
 ebc       =  1,
 sbc       =  1,
 nbc       =  1,
 bbc       =  3, ! Changed from supercell default 1 (free slip) to 3 (semi-slip)
 tbc       =  1,
 irbc      =  4,
 roflux    =  0,
 nudgeobc  =  0,
 isnd      =  7, ! Changed from supercell default 5 (W-K sounding to input sounding)
 iwnd      =  2, ! Now ignored because isnd = 7
 itern     =  0,
 iinit     =  1, ! warm bubble
 irandp    =  1, !Has to be on for noise [PSB]
 ibalance  =  0,
 iorigin   =  1, ! Changed from supercell default 2
 axisymm   =  0,
 imove     =  1,
 iptra     =  0,
 npt       =  1,
 pdtra     =  1,
 iprcl     =  0,
 nparcels  =  1,
 /

 &param3
 kdiff2  =   75.0,
 kdiff6  =   0.040,
 fcor    = 0.00005,
 kdiv    = 0.10,
 alph    = 0.60,
 rdalpha = 3.3333333333e-3,
 zd      = 25000.0, ! Changed from supercell default, 15km
 xhd     = 10000.0, !set to 10km for now [PSB] Jan 30
 alphobc = 60.0,
 umove   =   7.0, ! Changed to 7 after discussing with Morgan [PSB]
 vmove   =  -4.0, !Updated March 6th based on analysis of sim [PSB]
 v_t     =      7.0, !disregarded because ptype = 5
 l_h     =    100.0,
 lhref1  =    100.0,
 lhref2  =   1000.0,
 l_inf   =     75.0, !disregarded because iplb=0
 ndcnst  =    250.0,
 nt_c    =    250.0, !new CM1 variable, added akin to supercell namelist [PSB]
 csound  =    300.0, !same as above, but unused since ptype = 5 [PSB]
 cstar   =     30.0, !same as above, but unused since irbc = 4 [PSB]
 /

 &param11
